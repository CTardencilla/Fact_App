<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uamv.edu.ni.fact_app.controller.MenuPrincipalController"
            prefHeight="420.0"
            prefWidth="650.0"
            style="-fx-background-color: #F4F6F8;">

    <!-- Parte superior: título -->
    <top>
        <VBox alignment="CENTER"
              spacing="8.0"
              style="-fx-background-color: #2F5597;">

            <padding>
                <Insets top="22.0"
                        right="20.0"
                        bottom="22.0"
                        left="20.0"/>
            </padding>

            <Label text="SISTEMA DE FACTURACIÓN"
                   style="-fx-text-fill: white;
                          -fx-font-size: 24px;
                          -fx-font-weight: bold;"/>

            <Label text="Menú principal"
                   style="-fx-text-fill: white;
                          -fx-font-size: 15px;"/>
        </VBox>
    </top>

    <!-- Parte central: opciones disponibles -->
    <center>
        <VBox alignment="CENTER"
              spacing="20.0">

            <padding>
                <Insets top="35.0"
                        right="30.0"
                        bottom="35.0"
                        left="30.0"/>
            </padding>

            <Label text="Seleccione el módulo que desea visualizar"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #333333;"/>

            <HBox alignment="CENTER"
                  spacing="18.0">

                <Button text="Productos"
                        onAction="#abrirProductos"
                        prefHeight="90.0"
                        prefWidth="160.0"
                        style="-fx-background-color: #5B9BD5;
                               -fx-text-fill: white;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>

                <Button text="Cargos"
                        onAction="#abrirCargos"
                        prefHeight="90.0"
                        prefWidth="160.0"
                        style="-fx-background-color: #70AD47;
                               -fx-text-fill: white;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>

                <Button text="Categorías"
                        onAction="#abrirCategorias"
                        prefHeight="90.0"
                        prefWidth="160.0"
                        style="-fx-background-color: #ED7D31;
                               -fx-text-fill: white;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </center>

    <!-- Parte inferior: botón para cerrar el sistema -->
    <bottom>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-background-color: #E6E6E6;">

            <padding>
                <Insets top="12.0"
                        right="20.0"
                        bottom="12.0"
                        left="20.0"/>
            </padding>

            <Button text="Salir"
                    onAction="#salir"
                    prefWidth="100.0"
                    style="-fx-background-color: #C00000;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>