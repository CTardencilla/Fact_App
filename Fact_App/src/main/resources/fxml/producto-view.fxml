<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uamv.edu.ni.fact_app.controller.ProductoController"
            prefHeight="620.0"
            prefWidth="900.0"
            style="-fx-background-color: #F4F6F8;">

    <!-- Encabezado -->
    <top>
        <VBox alignment="CENTER"
              spacing="8.0"
              style="-fx-background-color: #2F5597;">

            <padding>
                <Insets top="18.0"
                        right="20.0"
                        bottom="18.0"
                        left="20.0"/>
            </padding>

            <Label text="GESTIÓN DE PRODUCTOS"
                   style="-fx-text-fill: white;
                          -fx-font-size: 23px;
                          -fx-font-weight: bold;"/>

            <Label text="Registrar, editar, eliminar y consultar productos"
                   style="-fx-text-fill: white;
                          -fx-font-size: 13px;"/>
        </VBox>
    </top>

    <!-- Formulario y tabla -->
    <center>
        <VBox spacing="15.0">

            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0"/>
            </padding>

            <Label text="Datos del producto"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #333333;"/>

            <HBox spacing="25.0">

                <!-- Campos del formulario -->
                <GridPane hgap="10.0"
                          vgap="10.0">

                    <Label text="Código:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtCodigo"
                               promptText="Ejemplo: P001"
                               prefWidth="260.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>

                    <Label text="Nombre:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <TextField fx:id="txtNombre"
                               promptText="Nombre del producto"
                               prefWidth="260.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>

                    <Label text="Categoría:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <ComboBox fx:id="cmbCategoria"
                              promptText="Seleccione una categoría"
                              prefWidth="260.0"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="2"/>

                    <Label text="Precio:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="3"/>

                    <TextField fx:id="txtPrecio"
                               promptText="Ejemplo: 100.00"
                               prefWidth="260.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="3"/>

                    <Label text="Existencia:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="4"/>

                    <TextField fx:id="txtExistencia"
                               promptText="Ejemplo: 10"
                               prefWidth="260.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="4"/>

                    <Label text="Estado:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="5"/>

                    <CheckBox fx:id="chkActivo"
                              text="Producto activo"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="5"/>
                </GridPane>

                <!-- Imagen del producto -->
                <VBox alignment="CENTER"
                      spacing="10.0"
                      style="-fx-border-color: #B7C9E2;
                             -fx-border-width: 1px;
                             -fx-background-color: white;
                             -fx-padding: 10px;">

                    <Label text="Imagen del producto"
                           style="-fx-font-weight: bold;"/>

                    <ImageView fx:id="imgProducto"
                               fitHeight="125.0"
                               fitWidth="160.0"
                               preserveRatio="true"/>

                    <Button text="Seleccionar imagen"
                            onAction="#seleccionarImagen"
                            style="-fx-background-color: #5B9BD5;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;"/>
                </VBox>
            </HBox>

            <!-- Botones CRUD -->
            <HBox spacing="10.0">

                <Button text="Guardar"
                        onAction="#guardar"
                        prefWidth="105.0"
                        style="-fx-background-color: #70AD47;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>

                <Button text="Editar"
                        onAction="#editar"
                        prefWidth="105.0"
                        style="-fx-background-color: #ED7D31;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>

                <Button text="Eliminar"
                        onAction="#eliminar"
                        prefWidth="105.0"
                        style="-fx-background-color: #C00000;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>

                <Button text="Limpiar"
                        onAction="#limpiar"
                        prefWidth="105.0"
                        style="-fx-background-color: #808080;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>

                <Button text="Cerrar"
                        onAction="#cerrar"
                        prefWidth="105.0"
                        style="-fx-background-color: #404040;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>
            </HBox>

            <Label text="Lista de productos"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #333333;"/>

            <!-- Tabla -->
            <TableView fx:id="tblProductos"
                       prefHeight="240.0"
                       prefWidth="860.0">

                <columns>

                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="95.0"/>

                    <TableColumn fx:id="colNombre"
                                 text="Nombre"
                                 prefWidth="200.0"/>

                    <TableColumn fx:id="colCategoria"
                                 text="Categoría"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="110.0"/>

                    <TableColumn fx:id="colExistencia"
                                 text="Existencia"
                                 prefWidth="110.0"/>

                    <TableColumn fx:id="colActivo"
                                 text="Activo"
                                 prefWidth="90.0"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>